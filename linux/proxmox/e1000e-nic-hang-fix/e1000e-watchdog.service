[Unit]
Description=Auto-recovery watchdog for e1000e NIC hangs (eno1, 82579LM)
Documentation=https://github.com/K3rn3l-P/sysadmin-field-notes/tree/main/linux/proxmox/e1000e-nic-hang-fix
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/sbin/e1000e-watchdog.sh
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
