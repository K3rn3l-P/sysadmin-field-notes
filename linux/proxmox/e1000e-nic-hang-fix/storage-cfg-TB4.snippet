# Snippet from /etc/pve/storage.cfg — replaces the original cifs:TB4 entry
# (which pointed at itself via //10.0.0.10/4TB) with local storage.
#
# BEFORE (wrong — CIFS towards this very host's IP):
#
#   cifs: TB4
#   	path /mnt/pve/TB4
#   	server 10.0.0.10
#   	share 4TB
#   	content images,snippets,rootdir,import,backup,iso,vztmpl
#   	prune-backups keep-all=1
#   	username Condiviso
#
# AFTER (right — a dir storage on the disk already mounted locally):
#
dir: TB4
	path /mnt/4TB
	content snippets,import,backup,iso,vztmpl
	prune-backups keep-all=1

# NOTES:
# - "images"/"rootdir" dropped from content: the disk is NTFS (via ntfs-3g), it
#   doesn't handle Unix permissions or symlinks, and on this host those
#   directories were empty anyway (no VM disks lived there).
# - After applying, remember to:
#     systemctl stop mnt-pve-TB4.mount   # if the old CIFS mount is still active
#     rm -f /etc/pve/priv/storage/TB4.pw # CIFS credential no longer used
#     systemctl restart pvestatd
#     pvesm status                       # check TB4 now shows as "dir" and "active"
